/*
 * tcp.mtp -- the TCP transport program, for the eTran/XDP target.
 *
 * Written against MTP.g4 on MTP-compiler @ mtp-dpdk-backend (9e7c7d6). The
 * grammar is the authority for what PARSES; examples/tcp-etran.mtp is
 * superseded and must not be read as a reference.
 *
 * INSTRUCTION SPELLING. The `_instr` suffix is the intended form and this
 * program uses it: new_ctx_instr, del_ctx_instr, pkt_gen_instr,
 * timer_start_instr. `timer_stop` has no suffix and is spelt as it is.
 *
 * The BACKENDS have not caught up -- DPDKGenerator implements the unsuffixed
 * names and answers "no emission for builtin 'new_ctx_instr'" -- so compiling
 * this program with --backend=dpdk reports those. That is the backend to fix,
 * not the program: both spellings parse, one as the grammar's token and one as
 * an ordinary call the generator happens to recognise, and only the first is
 * checkable. The eTran/XDP backend implements the suffixed names.
 *
 * WHAT THIS PROGRAM DESCRIBES. eTran (NSDI'25), as it actually behaves, not as
 * TCP is usually described. Every departure from ordinary TCP below is the
 * donor's and is marked; a compiler that "corrects" one of them produces a
 * different protocol. The behaviour was established by porting all fifteen
 * events into the eTran backend one at a time and reading the code at every
 * step -- see docs/EVENT-PORT-LOG.md in minmit/tmp-mtp-pass, which cites the
 * file and line for each claim.
 *
 * THE FOUR-WAY SPLIT IS IN THE PROGRAM, via @placement. eTran keeps one
 * connection's state in four structures across three address spaces: an eBPF
 * map, a shared mmapped array, the control path's own heap, and the
 * application's. MTP declares ONE context; @placement is how the program says
 * where a group of fields lives without pretending they are four contexts.
 */

/**************************** constants ****************************/

const uint8  FLAG_FIN = 0x01;
const uint8  FLAG_SYN = 0x02;
const uint8  FLAG_RST = 0x04;
const uint8  FLAG_PSH = 0x08;
const uint8  FLAG_ACK = 0x10;
const uint8  FLAG_ECE = 0x40;
const uint8  FLAG_CWR = 0x80;

/*
 * eTran's connection states. CONN_WAIT_RX_SYN is the state of a connection
 * accept() has created but no SYN has yet claimed -- the one state whose
 * contexts are deliberately NOT in the connection map.
 */
const uint8  CONN_WAIT_RX_SYN    = 0;
const uint8  CONN_WAIT_TX_SYNACK = 1;
const uint8  CONN_WAIT_RX_SYNACK = 2;
const uint8  CONN_WAIT_TX_SYN    = 3;
const uint8  CONN_OPEN           = 4;
const uint8  CONN_CLOSED         = 5;

/*
 * The KIND of a context, which eTran keeps separately from its state. A bound
 * socket is TYPE_FAKE: it holds a port and gives listen() something to find,
 * and it is never a connection. bind() and listen() write no state at all --
 * ST_BOUND and ST_LISTEN do not exist in the donor, and earlier versions of the
 * event documents invented them for exactly the two events that have none.
 */
const uint8  TYPE_FAKE   = 0;
const uint8  TYPE_NORMAL = 1;

/* PARITY: both initial sequence numbers are constants and neither is
 * randomised. The active open sends 0, the passive open sends 1. Reproduce,
 * do not correct. */
const uint32 PARITY_ISN_ACTIVE  = 0;
const uint32 PARITY_ISN_PASSIVE = 1;

/* PARITY: the advertised window is a constant in every control segment the
 * control path builds. */
const uint16 PARITY_CTRL_WINDOW = 11680;

const uint16 PARITY_MSS         = 1460;
const uint16 PARITY_MSS_W_TS    = 1448;   /* mss minus the timestamp option */

/* The compile-time bound on one listener's held SYNs. A SYN arriving with the
 * backlog full is DROPPED, silently -- not reset. */
const uint32 PROG_MAX_BACKLOG   = 512;

/* eTran offers ECN on every SYN unconditionally: there is no socket option and
 * no configuration for it. The two sides then test DIFFERENT things, and both
 * are right -- see proc_synack and proc_passive_open. */
const bool   PARITY_ALWAYS_OFFER_ECN = true;

const uint8  TRANSPORT_IP_PROTO = 6;
const uint8  IP_ECN_CE          = 0x03;   /* the low two bits of tos */

/*
 * Transmit priority. A segment that holds no position in the data stream must
 * not queue behind one that does, or a handshake waits on a full send buffer.
 */
const uint8  PRIO_CONTROL = 2;    /* SYN, SYN-ACK, RST: hold no data position */
const uint8  PRIO_ACK     = 1;    /* pure acknowledgements */
const uint8  PRIO_DATA    = 0;    /* payload */

const uint32 PARITY_DUP_ACK_THRESH = 3;      /* the donor acts on the third */
const uint32 TCP_MAX_RTT           = 1000000;
/* The receive window on the wire is SCALED. The donor shifts by a fixed amount
 * rather than negotiating it, and a program that forgets the shift advertises a
 * window 4096x too small -- which throttles the sender and reads as a transport
 * that is simply slow. */
const uint32 TCP_WND_SCALE         = 12;
/* Serialisation is subtracted from the RTT sample: the time to put the
 * acknowledged bytes on the wire is not the peer's delay. Bits per second. */
const uint32 LINK_BANDWIDTH        = 25000000000;

/**************************** parameters ****************************/

param uint32 tcp_handshake_timeout(50);    /* ms */
param uint32 tcp_close_timeout(100);       /* ms */

/**************************** flow ids ****************************/

/*
 * A connection is named by its four-tuple, remote half first, which is the
 * order the donor's key constructor uses.
 */
flow_id tcp_fid : (uint32, uint16, uint32, uint16);

/* A listening endpoint. */
flow_id tcp_lid : (uint32, uint16);

/**************************** events ****************************/

event app_bind : app_event {
    uint32 local_ip;        /* PARSED AND DISCARDED -- see proc_bind */
    uint16 local_port;
    bool   reuseport;
}

/*
 * app_listen carries ONLY the backlog. The call has no address of any kind:
 * appout_tcp_listen_t is {opaque_connection, opaque_listener, fd, backlog}, so
 * the listening endpoint cannot be set by the parser and proc_listen recovers
 * it from the bound context.
 */
event app_listen : app_event {
    uint32 pending_cap;
}

event app_accept : app_event {
    uint16 local_port;      /* which listening endpoint, from the app */
}

/* Likewise: the call carries the REMOTE endpoint only. */
event app_connect : app_event {
    uint32 remote_ip;
    uint16 remote_port;
}

event app_send : app_event {
    uint32 len;
}

event app_recv : app_event {
    uint32 len;
}

event app_close : app_event { }

event tcp_syn : net_event {
    uint32 seq;
    uint16 sport, dport, window;
    uint32 local_ip, remote_ip;
    uint32 ts_val;
    bool   has_ts, has_mss;
    bool   ece, cwr;
    uint32 qid;             /* the NIC queue it arrived on -- state, not
                             * bookkeeping: the eBPF half is keyed to it */
}

event tcp_synack : net_event {
    uint32 seq, ack;
    uint16 window;
    uint32 ts_val;
    bool   has_ts;
    bool   ece, cwr;
    uint32 qid;
}

event tcp_ack : net_event {
    uint32 seq, ack;
    uint16 window, flags;
    uint32 ts_val, ts_ecr;
    uint32 payload_len;
    bool   ecn_ce;
}

event tcp_data : net_event {
    uint32 seq, ack;
    uint16 window;
    uint32 ts_val, ts_ecr;
    uint32 payload_len;
    bool   ecn_ce;
}

event tcp_rst : net_event {
    uint32 seq, ack;
}

/*
 * tcp_fin EXISTS. eTran never SENDS a FIN and has no teardown handshake --
 * close() emits a RST -- but a FIN arriving on a closed connection is answered
 * with a bare ACK. An earlier README said eTran "neither sends nor processes a
 * FIN"; a program written from that sentence drops an arm the donor has.
 */
event tcp_fin : net_event {
    uint32 seq, ack;
}

event handshake_timeout : timer_event { }
event cc_interval_timeout : timer_event { }
event rto_timeout : timer_event { }

/**************************** packet shape ****************************/

pkt_bp TCPBP {
    uint16 src_port, dst_port;
    uint32 seq_no, ack_seq;
    /* data_off and checksum are fields the COMPILER fills: the program cannot
     * do arithmetic over the compiler's own option layout, which is the one
     * thing it does not know. */
    hdrlen4_t data_off;
    uint8  flags;
    uint16 window;
    checksum16_t checksum;
    uint16 urg_ptr;
    tcp_options opts;
    data_t data;
}

/* tos is read for its low two bits: eTran tests (iph->tos & IPTOS_ECN_CE) ==
 * IPTOS_ECN_CE on every segment, so congestion experienced is an L3 fact the
 * transport reads rather than a field of its own. */
net_header ipv4 { uint32 saddr, daddr; uint8 protocol; uint8 tos; }

opt_t opt_mss    { uint8 kind = 2; uint8 opt_len = 4;  uint16 mss; }
opt_t opt_nop    { uint8 kind = 1; }
opt_t opt_ts     { uint8 kind = 8; uint8 opt_len = 10; uint32 ts_val, ts_ecr; }
opt_union tcp_opt { opt_mss, opt_nop, opt_ts }
opt_list  tcp_options { list<tcp_opt> opts; }

/**************************** contexts ****************************/

/*
 * ONE context. The @placement groups are eTran's four storage classes, and the
 * split is the target's arrangement for this backend -- a target with one
 * address space would place the same program's fields once.
 */
context tcp_ctx {
    tcp_fid key;

    /*
     * (c) the control path's own heap. Everything connection setup and teardown
     * touches, and nothing the data path reads per packet.
     */
    @placement("control") {
        uint8  type = TYPE_FAKE;
        uint8  state = CONN_WAIT_RX_SYN;
        bool   reuseport;
        uint16 local_port, remote_port;
        uint32 local_ip, remote_ip;
        uint32 syn_ts;
        uint32 syn_attempts;
        uint32 next_timeout;
        uint32 qid;
        bool   ecn_enable;
    }

    /*
     * (a) the eBPF map, written by XDP and XDP_EGRESS under a spin lock. The
     * control path only creates and destroys these entries; per-packet
     * arithmetic happens here.
     */
    @placement("ebpf") {
        /* THE RING SIZES ARE EBPF-SIDE. They were placed on the control path,
         * which is wrong the moment proc_recv has to wrap rx_next_pos: the
         * donor keeps them in the map entry precisely because the fast path
         * needs them, and without the wrap the position walks off the ring. */
        uint32 rx_buf_size, tx_buf_size;
        uint32 rx_avail, rx_remote_avail;
        uint32 rx_next_pos, rx_next_seq;
        uint32 rx_dupack_cnt;
        uint32 rx_ooo_start, rx_ooo_len;
        uint32 tx_pending, tx_sent;
        uint32 tx_next_pos, tx_next_seq;
        uint32 tx_next_ts;
    }

    /*
     * (b) shared between the eBPF sites and the control loop, lock-free because
     * each variable has exactly one writer.
     */
    @placement("cc_shared") {
        uint32 cnt_tx_drops, cnt_rx_acks;
        uint32 cnt_rx_ack_bytes, cnt_rx_ecn_bytes;
        uint32 rtt_est;
        uint32 rate;
        bool   txp;
    }

    /*
     * (d) the application's own address space. The micro kernel never touches
     * these; the app thread does its own segmentation and ring bookkeeping.
     */
    @placement("app") {
        uint32 rxb_head, rxb_used, rxb_bump;
        uint32 txb_head, txb_sent, txb_allocated;
        bool   force_rx_bump, in_rx_bump_pending;
    }

    timer_t handshake_timer;
    timer_t rto_timer;
}

/*
 * The listening endpoint. ONE ID SELECTS SEVERAL INSTANCES here: SO_REUSEPORT
 * puts one listener per socket under one endpoint and an arriving SYN picks
 * among them by hashing its four-tuple. MTP's model is that an id selects THE
 * instance, so this is the one place the program cannot be written as the
 * language describes. [GAP: REUSEPORT]
 */
/*
 * A HELD SYN. Everything the shared passive-open tail reads, captured when the
 * SYN arrives and decoded later -- which is the donor's own order, and the only
 * order that works: on the accept() path the event is an app_accept and the SYN
 * is long gone.
 */
struct pending_syn {
    uint32 seq;
    uint16 sport, dport;
    uint32 local_ip, remote_ip;
    uint32 ts_val;
    bool   has_ts, has_mss;
    bool   ece, cwr;
    uint32 qid;
    bool   valid;
}

context tcp_listen_ctx {
    tcp_lid key;

    uint32 local_ip;
    uint16 local_port;

    uint32 pending_cap;         /* the backlog argument. It bounds the queue of
                                 * held SYNs -- NOT the queue of completed
                                 * connections, which holds exactly one. */
    uint32 pending_n;
    /* THE QUEUE HOLDS THE SYN, NOT A FLOW ID. It used to hold a tcp_fid, which
     * threw away everything proc_passive_open needs -- the sequence number, the
     * timestamp, the queue it arrived on, whether ECN was offered -- and then
     * read those fields off an `ev` that, on the accept() path, is an app_accept
     * carrying none of them. The donor is explicit about this: it copies the raw
     * SYN into the backlog and decodes it at passive-open time. */
    pending_syn pending[PROG_MAX_BACKLOG];

    /* The completed connection waiting for accept(). Capacity ONE, whatever
     * pending_cap says. */
    tcp_fid accepted;
    bool    has_accepted;
}

/**************************** scratchpad ****************************/

/*
 * THE DONOR'S SCRATCHPAD, FIELD FOR FIELD. It used to be five fields of our own
 * naming, which is fine while nothing else reads it and impossible the moment a
 * generated processor has to sit in a chain beside a hand-written one -- they
 * share this, and two definitions of it cannot both be right.
 *
 * `seq` and `payload_len` are MUTABLE COPIES of the event's, because trimming
 * changes them and the event is what arrived, not what will be accepted.
 * `seg_ok` is the one field the donor does not have: it says the chain is still
 * live, which the donor says by returning false. MTP has no way to refuse
 * (docs/REFUSAL.md), so it is carried.
 */
scratchpad_t tcp_scratch {
    uint32 seq;
    uint32 ack_seq;
    uint32 ts_val;
    uint32 ts_ecr;
    uint32 now;
    uint32 payload_off;
    uint32 payload_len;
    uint32 rx_bump;
    uint32 tx_bump;
    uint32 go_back_pos;
    uint32 trim_start;
    uint32 trim_end;
    bool   trigger_ack;
    bool   clear_ooo;
    bool   drop;
    bool   seg_ok;
}

/**************************** the app parser ****************************/

app_parser socket {
    bind    -> sock_bind;
    listen  -> sock_listen;
    accept  -> sock_accept;
    connect -> sock_connect;
    send    -> sock_send;
    recv    -> sock_recv;
    close   -> sock_close;
}

/*
 * THE ID A BOUND SOCKET IS FILED UNDER IS NOT ITS ENDPOINT.
 *
 * With no peer there is no four-tuple, so eTran fabricates one out of the
 * application's socket handle: three quarters of the key are slices of a
 * pointer. MTP permits it -- a context id is a tuple the program builds -- but
 * it means a bound socket's identity is an address. [GAP: SYNTHETIC-ID]
 *
 * The same fabrication has to be reproduced by listen(), accept() and close(),
 * because that is how they find the context again.
 */
list<event_t> sock_bind(bind op) {
    list<event_t> out;
    app_bind ev;

    ev.local_ip   = op.local.ip;
    ev.local_port = op.local.port;
    ev.reuseport  = op.reuseport;
    set_ctx_lookup_info(ev, tcp_ctx,
                        tcp_fid(uint32(op.handle >> 16), uint16(op.handle),
                                uint32(op.handle >> 32), op.local.port));
    out.add(ev);
    return out;
}

list<event_t> sock_listen(listen op) {
    list<event_t> out;
    app_listen ev;

    ev.pending_cap = op.len;
    /* The BOUND context, by the same fabricated id. The listening endpoint is
     * not knowable here -- the call carries no address -- so proc_listen
     * derives it from the context this resolves to. */
    set_ctx_lookup_info(ev, tcp_ctx,
                        tcp_fid(uint32(op.handle >> 16), uint16(op.handle),
                                uint32(op.handle >> 32), op.local.port));
    out.add(ev);
    return out;
}

list<event_t> sock_accept(accept op) {
    list<event_t> out;
    app_accept ev;

    ev.local_port = op.local.port;
    set_ctx_lookup_info(ev, tcp_listen_ctx, tcp_lid(op.local.ip, op.local.port));
    out.add(ev);
    return out;
}

list<event_t> sock_connect(connect op) {
    list<event_t> out;
    app_connect ev;

    ev.remote_ip   = op.remote.ip;
    ev.remote_port = op.remote.port;
    set_ctx_lookup_info(ev, tcp_ctx,
                        tcp_fid(uint32(op.handle >> 16), uint16(op.handle),
                                uint32(op.handle >> 32), op.local.port));
    out.add(ev);
    return out;
}

list<event_t> sock_send(send op) {
    list<event_t> out;
    app_send ev;

    ev.len = op.len;
    set_ctx_lookup_info(ev, tcp_ctx,
                        tcp_fid(op.remote.ip, op.remote.port,
                                op.local.ip, op.local.port));
    out.add(ev);
    return out;
}

list<event_t> sock_recv(recv op) {
    list<event_t> out;
    app_recv ev;

    ev.len = op.len;
    set_ctx_lookup_info(ev, tcp_ctx,
                        tcp_fid(op.remote.ip, op.remote.port,
                                op.local.ip, op.local.port));
    out.add(ev);
    return out;
}

/* The close call carries the four-tuple and eTran ignores every field of it:
 * the context is found by handle like every other socket call. */
list<event_t> sock_close(close op) {
    list<event_t> out;
    app_close ev;

    set_ctx_lookup_info(ev, tcp_ctx,
                        tcp_fid(op.remote.ip, op.remote.port,
                                op.local.ip, op.local.port));
    out.add(ev);
    return out;
}

/**************************** the net parser ****************************/

/*
 * The parser classifies and extracts. It does NOT look contexts up: it names
 * the context type and the id, and the target resolves them (D-33).
 *
 * eTran splits the work between two sites, and the split is visible here as
 * which events exist at all. SYN, SYN-ACK and RST are redirected out of XDP to
 * the control path; everything else is handled in eBPF and never reaches
 * userspace. One program, two execution sites, one parser.
 */
list<event_t> parse_tcp(pkt_t p, ipv4 h) {
    list<event_t> out;

    TCPBP  bp = extract(p);
    uint32 payload_len;

    if (p.len < 20 || bp.data_off * 4 < 20 || bp.data_off * 4 > p.len)
        return out;
    payload_len = p.len - bp.data_off * 4;

    tcp_fid fid = tcp_fid(h.saddr, bp.src_port, h.daddr, bp.dst_port);
    tcp_lid lid = tcp_lid(h.daddr, bp.dst_port);

    /* A SYN with no ACK is answered from the LISTENER: no connection exists for
     * it to name yet, so it is the one segment keying a different context. */
    if ((bp.flags & FLAG_SYN) != 0 && (bp.flags & FLAG_ACK) == 0) {
        tcp_syn s;
        s.seq = bp.seq_no;
        s.sport = bp.src_port;  s.dport = bp.dst_port;
        s.window = bp.window;
        s.local_ip = h.daddr;   s.remote_ip = h.saddr;
        s.ts_val = bp.opts.ts_val;
        s.has_ts = bp.opts.has_ts;
        s.has_mss = bp.opts.has_mss;
        s.ece = (bp.flags & FLAG_ECE) != 0;
        s.cwr = (bp.flags & FLAG_CWR) != 0;
        s.qid = p.qid;
        set_ctx_lookup_info(s, tcp_listen_ctx, lid);
        out.add(s);
        return out;
    }

    if ((bp.flags & FLAG_SYN) != 0) {
        tcp_synack sa;
        sa.seq = bp.seq_no;  sa.ack = bp.ack_seq;  sa.window = bp.window;
        sa.ts_val = bp.opts.ts_val;
        sa.has_ts = bp.opts.has_ts;
        sa.ece = (bp.flags & FLAG_ECE) != 0;
        sa.cwr = (bp.flags & FLAG_CWR) != 0;
        sa.qid = p.qid;
        set_ctx_lookup_info(sa, tcp_ctx, fid);
        out.add(sa);
        return out;
    }

    if ((bp.flags & FLAG_RST) != 0) {
        tcp_rst r;
        r.seq = bp.seq_no;  r.ack = bp.ack_seq;
        set_ctx_lookup_info(r, tcp_ctx, fid);
        out.add(r);
        return out;
    }

    if ((bp.flags & FLAG_FIN) != 0) {
        tcp_fin f;
        f.seq = bp.seq_no;  f.ack = bp.ack_seq;
        set_ctx_lookup_info(f, tcp_ctx, fid);
        out.add(f);
        return out;
    }

    /*
     * EVERY REMAINING SEGMENT RAISES tcp_ack, AND A SEGMENT WITH PAYLOAD ALSO
     * RAISES tcp_data. The two chains INTERLEAVE in the donor -- tcp_ack's
     * window and RTT updates run AFTER tcp_data's sequence validation and are
     * skipped by its early exits, so a segment with a bad sequence number never
     * updates the receive window even though the window is ACK state.
     *
     * The dispatch below states the braid explicitly. Running the two lists one
     * after the other would be a different program.
     */
    tcp_ack a;
    a.seq = bp.seq_no;  a.ack = bp.ack_seq;
    a.window = bp.window;  a.flags = bp.flags;
    a.ts_val = bp.opts.ts_val;  a.ts_ecr = bp.opts.ts_ecr;
    a.payload_len = payload_len;
    a.ecn_ce = (h.tos & IP_ECN_CE) == IP_ECN_CE;
    set_ctx_lookup_info(a, tcp_ctx, fid);
    out.add(a);

    if (payload_len > 0) {
        tcp_data d;
        d.seq = bp.seq_no;  d.ack = bp.ack_seq;
        d.window = bp.window;
        d.ts_val = bp.opts.ts_val;  d.ts_ecr = bp.opts.ts_ecr;
        d.payload_len = payload_len;
        d.ecn_ce = (h.tos & IP_ECN_CE) == IP_ECN_CE;
        set_ctx_lookup_info(d, tcp_ctx, fid);
        out.add(d);
    }

    return out;
}

/**************************** processors ****************************/

/*
 * proc_bind. Creates a DEGENERATE context: it holds the port and gives listen()
 * something to find. No eBPF state exists yet -- there is no four-tuple to key
 * an entry on.
 *
 * TODO(error handling): eTran refuses a second bind on this handle, and refuses
 * a port another application owns unless SO_REUSEPORT is set. Both need to know
 * whether the context is already present, which the PROGRAM does not know --
 * that is the target's knowledge. MTP has no presence test and error-handling
 * primitives are future work.
 *
 * ORDER NOTE: the donor allocates the context BEFORE testing the port and frees
 * it again on failure. Written with new_ctx after the guards, which is
 * behaviour-preserving because nothing can observe an unregistered context.
 */
void proc_bind(app_bind ev, tcp_ctx ctx) {
    tcp_fid fid = ctx.key;
    new_ctx_instr(fid);

    ctx.type      = TYPE_FAKE;
    ctx.reuseport = ev.reuseport;
    ctx.local_port = ev.local_port;

    /* ev.local_ip IS DISCARDED. Every bind takes the node's single configured
     * address; the donor reads the field into a local and writes
     * `(void)_local_ip; // FIXME`. Binding to a specific address is not
     * implemented, and a program that honoured the field would not be eTran. */

    notify(ctx, BOUND);
}

/*
 * proc_listen. The guard is the context's KIND, not a state: "this handle is a
 * bound socket, not a connection". Nothing marks the bound context as
 * listening -- the listener's existence is what says so.
 */
void proc_listen(app_listen ev, tcp_ctx bound, tcp_listen_ctx lst) {
    if (bound.type != TYPE_FAKE)
        return;

    tcp_lid lid = tcp_lid(bound.local_ip, bound.local_port);
    new_ctx_instr(lid);

    lst.local_ip    = bound.local_ip;
    lst.local_port  = bound.local_port;
    lst.pending_cap = ev.pending_cap;
    lst.pending_n   = 0;
    lst.has_accepted = false;

    notify(lst, LISTENING);
}

/*
 * proc_accept. THE CONTEXT IS CREATED BEFORE ITS IDENTITY EXISTS: this is the
 * connection that will receive the NEXT SYN, so its remote address -- three
 * quarters of its id -- is still zero. eTran keeps it off the connection map
 * entirely until a SYN supplies one.
 *
 * MTP's new_ctx takes the id, because a context and its identity normally
 * arrive together. Here they do not, and the target has to allow a context that
 * is not yet addressable. [GAP: UNIDENTIFIED-CTX]
 *
 * There is no notify on this path. The application is told when the SYN-ACK
 * goes out, from gen_synack.
 */
void proc_accept(app_accept ev, tcp_listen_ctx lst) {
    /* Exactly ONE completed connection may wait, whatever pending_cap says --
     * that cap governs the queue of held SYNs, which is a different queue. */
    if (lst.has_accepted)
        return;

    lst.has_accepted = true;
}

/*
 * proc_connect. The local address is the node's configured one and the local
 * port is the bound context's, or the allocator's if no bind ran -- neither is
 * in the call.
 *
 * THE CONTEXT'S IDENTITY CHANGES HERE. If bind() ran, this context is already
 * filed under the fabricated id of sock_bind; connect overwrites its address
 * fields with the real four-tuple and eTran files it AGAIN, keeping both. Close
 * then removes only one. MTP has no instruction for an identity change; the
 * target reproduces the donor rather than tidying it, because tidying it is a
 * protocol change. [GAP: ID-CHANGE]
 */
void proc_connect(app_connect ev, tcp_ctx ctx) {
    ctx.type        = TYPE_NORMAL;
    ctx.remote_ip   = ev.remote_ip;
    ctx.remote_port = ev.remote_port;
    ctx.state       = CONN_WAIT_TX_SYN;
    ctx.rx_next_seq = 0;
    ctx.tx_next_seq = PARITY_ISN_ACTIVE;
    ctx.syn_attempts = 0;

    tcp_fid fid = ctx.key;
    new_ctx_instr(fid);

    /* status 0 means "in progress". The application is notified a SECOND time
     * when the SYN-ACK lands, and connect() polls for that one. Two
     * notifications for one call has no MTP form. */
    notify(ctx, CONNECTING);
}

/*
 * gen_syn. DEFERRED: the donor does not emit a SYN inside connect(). The
 * context is parked and the control loop drains it on its next pass, which is
 * why this is a separate processor rather than the tail of proc_connect.
 */
void gen_syn(app_connect ev, tcp_ctx ctx) {
    if (ctx.state != CONN_WAIT_TX_SYN)
        return;

    ctx.state = CONN_WAIT_RX_SYNACK;
    timer_start_instr(ctx.handshake_timer, millisecond(tcp_handshake_timeout));

    TCPBP bp;
    bp.src_port = ctx.local_port;
    bp.dst_port = ctx.remote_port;
    bp.seq_no   = ctx.tx_next_seq;
    bp.ack_seq  = 0;
    bp.window   = PARITY_CTRL_WINDOW;
    /* PARITY: always ECN-capable. No socket option, no configuration. */
    bp.flags    = FLAG_SYN | FLAG_ECE | FLAG_CWR;
    bp.opts.add(opt_mss(PARITY_MSS));
    bp.opts.add(opt_ts(0, 0));
    pkt_gen_instr(bp, PRIO_CONTROL, false);
}

/*
 * proc_passive_open -- the SUFFIX tcp_syn AND app_accept SHARE. Either the SYN
 * arrives while an accept waits, or an accept arrives while the SYN is queued.
 * MTP has no way to say two events share a tail; both dispatch entries name it.
 *
 * This is where the context accept() created without an identity gets one.
 */
/*
 * THE EVENT IS `event_t`, DELIBERATELY. This processor is the tail that tcp_syn
 * and app_accept share, and those two carry different fields -- app_accept has
 * only a port. Naming either concrete type here is a claim the other cannot
 * satisfy; it read `ev.seq` off an app_accept until the link check made the
 * dispatch compile. Everything it needs comes from the queue.
 */
void proc_passive_open(event_t ev, tcp_listen_ctx lst, tcp_ctx ctx) {
    pending_syn syn;

    if (!lst.has_accepted) {
        /* No accept waiting: the SYN stays queued. proc_syn_queue already put
         * it there, so there is nothing to do but tell the application. */
        if (lst.pending_n == 0)
            return;
        notify(lst, NEW_CONN);
        return;
    }

    if (lst.pending_n == 0)
        return;                       /* accept() waiting, no SYN yet */
    syn = lst.pending[0];

    /* The options are re-parsed HERE, not when the SYN arrived: the donor
     * copies 256 raw bytes into the backlog and decodes them at this point,
     * which is why MSS and the timestamp are read later than received. */
    if (!syn.has_ts || !syn.has_mss)
        return;

    ctx.qid         = syn.qid;
    ctx.type        = TYPE_NORMAL;
    ctx.local_ip    = syn.local_ip;
    ctx.local_port  = syn.dport;
    ctx.remote_ip   = syn.remote_ip;
    ctx.remote_port = syn.sport;
    ctx.rx_next_seq = syn.seq + 1;
    ctx.tx_next_seq = PARITY_ISN_PASSIVE;
    ctx.syn_ts      = syn.ts_val;

    /* The OFFER is ECE and CWR together. The active side treats ECE ALONE as
     * the acceptance -- the two sides test different things and both are
     * right. */
    if (syn.ece && syn.cwr)
        ctx.ecn_enable = true;

    /* Only now is the context addressable by its id. */
    tcp_fid fid = ctx.key;
    new_ctx_instr(fid);

    ctx.state = CONN_WAIT_TX_SYNACK;
    lst.has_accepted = false;

    /* THE SYN IS SPENT. Both halves of the rendezvous are consumed together --
     * leaving it queued would hand the same SYN to the next accept(). */
    uint32 i = 0;
    while (i + 1 < lst.pending_n) {
        lst.pending[i] = lst.pending[i + 1];
        i = i + 1;
    }
    lst.pending_n = lst.pending_n - 1;
}

/*
 * The tcp_syn half of the rendezvous: hold the SYN so the shared tail can read
 * it, whether the accept() has already arrived or comes later. A full backlog
 * DROPS it -- silently, and not with a reset, which is the donor's behaviour.
 */
void proc_syn_queue(tcp_syn ev, tcp_listen_ctx lst) {
    pending_syn syn;

    if (lst.pending_n >= lst.pending_cap)
        return;

    syn.seq       = ev.seq;
    syn.sport     = ev.sport;
    syn.dport     = ev.dport;
    syn.local_ip  = ev.local_ip;
    syn.remote_ip = ev.remote_ip;
    syn.ts_val    = ev.ts_val;
    syn.has_ts    = ev.has_ts;
    syn.has_mss   = ev.has_mss;
    syn.ece       = ev.ece;
    syn.cwr       = ev.cwr;
    syn.qid       = ev.qid;
    syn.valid     = true;

    lst.pending[lst.pending_n] = syn;
    lst.pending_n = lst.pending_n + 1;
}

/*
 * gen_synack. DEFERRED, like gen_syn. Marks the connection OPEN *before* the
 * SYN-ACK is emitted and NEVER WAITS FOR THE THIRD ACK: the passive side is
 * live from this moment, which is why a retransmitted SYN later cannot be told
 * from a new one.
 */
/* `event_t`, because tcp_syn and app_accept both end here -- and it reads
 * nothing off the event anyway: a SYN-ACK is built entirely from the context. */
void gen_synack(event_t ev, tcp_ctx ctx) {
    if (ctx.state != CONN_WAIT_TX_SYNACK)
        return;

    ctx.state = CONN_OPEN;

    TCPBP bp;
    bp.src_port = ctx.local_port;
    bp.dst_port = ctx.remote_port;
    bp.seq_no   = ctx.tx_next_seq;
    bp.ack_seq  = ctx.rx_next_seq;
    bp.window   = PARITY_CTRL_WINDOW;
    bp.flags    = FLAG_SYN | FLAG_ACK;
    if (ctx.ecn_enable)
        bp.flags = bp.flags | FLAG_ECE;
    bp.opts.add(opt_mss(PARITY_MSS));
    bp.opts.add(opt_ts(0, ctx.syn_ts));
    pkt_gen_instr(bp, PRIO_CONTROL, false);

    /* accept() returns from HERE, not from proc_accept. */
    notify(ctx, ACCEPTED);
}

/*
 * proc_synack. The ORDER is the unusual part and is the donor's: the eBPF half
 * of the context is created and the application is told the connection is open
 * BEFORE the third ACK is emitted. By the time that ACK leaves, connect() has
 * returned and the fast path is running.
 */
void proc_synack(tcp_synack ev, tcp_ctx ctx) {
    if (ctx.state != CONN_WAIT_RX_SYNACK)
        return;

    /* The NIC queue this connection's eBPF half will be keyed to. A state
     * write, not bookkeeping. */
    ctx.qid = ev.qid;
    timer_stop(ctx.handshake_timer);

    if (!ev.has_ts) {
        /* Restore every field this processor would have written and retry the
         * SYN -- the donor rewinds rather than tearing down. */
        ctx.rx_next_seq = 0;
        ctx.tx_next_seq = 0;
        ctx.syn_ts      = 0;
        ctx.ecn_enable  = false;
        timer_start_instr(ctx.handshake_timer, millisecond(tcp_handshake_timeout));
        return;
    }

    ctx.rx_next_seq = ev.seq + 1;
    /* NOT +1: the SYN's octet is already counted in the peer's acknowledgement. */
    ctx.tx_next_seq = ev.ack;
    ctx.syn_ts      = ev.ts_val;

    /* ECE ALONE is the acceptance. ECE|CWR is the offer. */
    if (ev.ece && !ev.cwr)
        ctx.ecn_enable = true;

    ctx.state = CONN_OPEN;
    notify(ctx, CONN_OPEN_OK);

    TCPBP bp;
    bp.src_port = ctx.local_port;
    bp.dst_port = ctx.remote_port;
    bp.seq_no   = ctx.tx_next_seq;
    bp.ack_seq  = ctx.rx_next_seq;
    bp.window   = PARITY_CTRL_WINDOW;
    bp.flags    = FLAG_ACK;
    bp.opts.add(opt_ts(0, ctx.syn_ts));
    pkt_gen_instr(bp, PRIO_ACK, false);
}

/*
 * proc_rst. notify_close then teardown. eTran ANSWERS A RST WITH A RST: the
 * teardown path emits one unconditionally, which is the donor's behaviour and
 * not a mistake in transcription.
 */
void proc_rst(tcp_rst ev, tcp_ctx ctx) {
    notify(ctx, PEER_RESET);
    tcp_fid dead = ctx.key;
    destroy_ctx_instr(dead);
}

/*
 * proc_fin. A FIN on an already-closed connection, answered with a bare ACK.
 * The donor's own comment is "TODO figure out why necessary"; kept, including
 * the puzzlement. No FIN ever advances a connection here.
 */
void proc_fin(tcp_fin ev, tcp_ctx ctx) {
    if (ctx.state != CONN_CLOSED)
        return;

    TCPBP bp;
    bp.src_port = ctx.local_port;
    bp.dst_port = ctx.remote_port;
    bp.seq_no   = ctx.tx_next_seq;
    bp.ack_seq  = ctx.rx_next_seq;
    bp.window   = PARITY_CTRL_WINDOW;
    bp.flags    = FLAG_ACK;
    pkt_gen_instr(bp, PRIO_ACK, false);
}

/*
 * proc_close. mark_closed and gen_rst are ONE step in the donor: the teardown
 * emits the RST itself. eTran has no FIN and no teardown handshake -- close()
 * resets the connection.
 */
void proc_close(app_close ev, tcp_ctx ctx) {
    ctx.state = CONN_CLOSED;

    TCPBP bp;
    bp.src_port = ctx.local_port;
    bp.dst_port = ctx.remote_port;
    bp.seq_no   = ctx.tx_next_seq;
    bp.ack_seq  = ctx.rx_next_seq;
    bp.flags    = FLAG_RST;
    pkt_gen_instr(bp, PRIO_CONTROL, false);

    tcp_fid dead = ctx.key;
    destroy_ctx_instr(dead);
    notify(ctx, CLOSED);
}

/*
 * THE DATA PATH.
 *
 * Every processor below touches only fields the program placed in "ebpf" or
 * "cc_shared", or only ones it placed in "app". That is not a coincidence and it
 * is not a hint to the compiler: it is what DECIDES where they run. eTran keeps
 * the per-packet state in an eBPF map and the ring bookkeeping in the
 * application's memory, so a processor over the first can run in XDP and a
 * processor over the second cannot.
 */

/*
 * proc_ack. Acknowledgement arithmetic and duplicate detection.
 *
 * The donor accepts an ACK for bytes it has SUBMITTED but whose egress pass has
 * not run yet, which is why the window it checks against runs from
 * tx_next_seq - tx_sent to tx_next_seq + tx_pending rather than to tx_next_seq.
 */
void proc_ack(tcp_ack ev, tcp_ctx ctx, tcp_scratch s) {
    s.tx_bump = 0;
    s.trigger_ack = ev.payload_len > 0;

    ctx.cnt_rx_acks = ctx.cnt_rx_acks + 1;

    uint32 first = ctx.tx_next_seq - ctx.tx_sent;
    if (!in_range(ev.ack, first, ctx.tx_next_seq + ctx.tx_pending)) {
        s.trigger_ack = false;
        return;
    }

    s.tx_bump = ev.ack - first;
    if (s.tx_bump > ctx.tx_sent) {
        /* A retransmission acknowledged twice. Not an error, and not counted. */
        s.tx_bump = 0;
        s.trigger_ack = false;
        return;
    }

    ctx.cnt_rx_ack_bytes = ctx.cnt_rx_ack_bytes + s.tx_bump;
    if (ev.ecn_ce)
        ctx.cnt_rx_ecn_bytes = ctx.cnt_rx_ecn_bytes + s.tx_bump;

    ctx.tx_sent = ctx.tx_sent - s.tx_bump;
    ctx.txp = ctx.tx_sent > 0;

    if (s.tx_bump > 0)
        ctx.rx_dupack_cnt = 0;
}

/*
 * proc_fast_retransmit. Four conditions, all of them, and the donor writes them
 * out: nothing was acknowledged, something is outstanding, the segment carried
 * no payload, and the advertised window did not move -- a window update is not a
 * duplicate. Only then is a third duplicate a loss signal.
 */
void proc_fast_retransmit(tcp_ack ev, tcp_ctx ctx, tcp_scratch s) {
    if (s.tx_bump > 0)
        return;
    if (ctx.tx_sent == 0)
        return;
    if (ev.payload_len != 0)
        return;
    if (ctx.rx_remote_avail != ev.window)
        return;

    ctx.rx_dupack_cnt = ctx.rx_dupack_cnt + 1;
    if (ctx.rx_dupack_cnt != PARITY_DUP_ACK_THRESH)
        return;

    /* Go back to the first unacknowledged byte. */
    s.go_back_pos = ctx.tx_sent;
    ctx.rx_dupack_cnt = 0;
    ctx.tx_next_seq = ctx.tx_next_seq - ctx.tx_sent;
    ctx.rx_remote_avail = ctx.rx_remote_avail + ctx.tx_sent;
    ctx.tx_pending = 0;
    ctx.tx_sent = 0;
    ctx.txp = false;

    /* Halve once per interval, not once per duplicate. */
    if (ctx.cnt_tx_drops == 0)
        ctx.rate = ctx.rate >> 1;
    ctx.cnt_tx_drops = ctx.cnt_tx_drops + 1;
}

/*
 * proc_window and proc_rtt. THESE ARE tcp_ack PROCESSORS AND THEY RUN AFTER
 * tcp_data's validation -- see the dispatch. A segment with a bad sequence
 * number never reaches them, so it never updates the receive window, even
 * though the window is ACK state. That is the donor's braid, not a simplification.
 */
void proc_window(tcp_ack ev, tcp_ctx ctx, tcp_scratch s) {
    /* SCALED. `ev.window` is the sixteen bits off the wire; what the sender may
     * have outstanding is that shifted. The program said `ev.window` and would
     * have advertised 1/4096 of the real window. */
    /* WIDENED BEFORE SHIFTING. `ev.window` is sixteen bits; shifting it left by
     * twelve promotes to a SIGNED int in C, and the comparison against an
     * unsigned then warns -- rightly, because the same expression on a wider
     * shift would overflow into the sign bit. The program says the width it
     * means. */
    if (s.tx_bump > 0 || ctx.rx_remote_avail < (uint32(ev.window) << TCP_WND_SCALE))
        ctx.rx_remote_avail = uint32(ev.window) << TCP_WND_SCALE;
}

void proc_rtt(tcp_ack ev, tcp_ctx ctx, tcp_scratch s) {
    /* THE TIMESTAMP TO ECHO, taken from the first segment that carried data and
     * not replaced until it has been sent. The program omitted this entirely,
     * so every outgoing segment would have echoed zero and the peer's own RTT
     * estimate would have been meaningless. */
    if (ev.payload_len > 0 && ctx.tx_next_ts == 0)
        ctx.tx_next_ts = ev.ts_val;

    if (ev.ts_ecr == 0 || s.tx_bump == 0)
        return;

    /*
     * THE SAMPLE IS AGAINST NOW, NOT AGAINST THE PEER'S CLOCK. `ev.ts_val` is
     * the sender's timestamp and subtracting the echo from it measures nothing
     * -- the program did exactly that. It is now-minus-echo, in nanoseconds,
     * converted to microseconds, less the time it took to put the acknowledged
     * bytes on the wire, which is ours and not the peer's delay.
     */
    uint32 rtt = (now() - ev.ts_ecr) / 1000;
    rtt = rtt - (s.tx_bump * 1000000) / LINK_BANDWIDTH;
    if (rtt >= TCP_MAX_RTT)
        return;

    /* A seven-eighths exponential average, which is what the donor keeps. */
    if (ctx.rtt_est > 0)
        ctx.rtt_est = (ctx.rtt_est * 7 + rtt) / 8;
    else
        ctx.rtt_est = rtt;
}

/*
 * proc_seq. Validation, and it heads the chain: every segment the state machine
 * sees carries the ACK flag, so this runs exactly once per segment and the
 * payload processing below reads its verdict.
 */
/*
 * SEQUENCE VALIDATION AND TRIMMING. The program used to say `seg_ok = seq ==
 * rx_next_seq` and nothing else, which accepts a segment that overlaps what has
 * already been delivered and one that runs past the advertised window -- both
 * of which the donor trims rather than accepts whole.
 *
 * THE COMPARISONS ARE WRAP-SAFE and are written out rather than using the
 * language's `in_range`, which compiles to a plain `a >= b && a <= c`. Sequence
 * space wraps; a plain comparison is wrong for every connection that lives long
 * enough to pass 2^32, and wrong immediately for one whose ISN is near the top.
 * `(x - start) < (end - start)` in unsigned arithmetic is the half-open test
 * that survives the wrap, and it is why these fields must be unsigned.
 */
void proc_seq(tcp_data ev, tcp_ctx ctx, tcp_scratch s) {
    uint32 exp_first = ctx.rx_next_seq;
    uint32 exp_last  = ctx.rx_next_seq + ctx.rx_avail;
    uint32 pkt_first = ev.seq;
    uint32 pkt_last  = ev.seq + ev.payload_len;
    uint32 exp_width = exp_last - exp_first;
    uint32 pkt_width = pkt_last - pkt_first;

    s.seq         = ev.seq;
    s.payload_len = ev.payload_len;

    /* Any overlap at all, in either direction. The last two terms are what
     * catches a segment that CONTAINS the whole window. */
    bool first_in = (pkt_first - exp_first) < exp_width;
    bool last_in  = (pkt_last - exp_first - 1) < exp_width;
    bool valid = first_in || last_in
              || (exp_first - pkt_first) < pkt_width
              || (exp_last - pkt_first - 1) < pkt_width;

    if (!valid) {
        /* Out of window entirely. No acknowledgement is triggered -- the donor
         * is explicit that a bad sequence number does not provoke one. */
        s.trigger_ack = false;
        s.seg_ok = false;
        s.payload_len = 0;
        return;
    }

    /* Bytes at the front already delivered, and bytes at the back past the
     * window. Both are dropped from the segment rather than the segment. */
    if (first_in)
        s.trim_start = 0;
    else
        s.trim_start = exp_first - pkt_first;

    if (last_in)
        s.trim_end = 0;
    else
        s.trim_end = pkt_last - exp_last;

    s.payload_off = s.payload_off + s.trim_start;
    if (ev.payload_len >= s.trim_start + s.trim_end)
        s.payload_len = ev.payload_len - s.trim_start - s.trim_end;
    s.seq = ev.seq + s.trim_start;

    s.seg_ok = s.seq == ctx.rx_next_seq;
}

/*
 * proc_ooo. One interval, not a list. The donor keeps a single out-of-order
 * extent and merges only at its edges; a segment that touches neither edge is
 * dropped rather than held, which is why a hole with two gaps costs a
 * retransmission.
 */
/*
 * The out-of-order interval, which is ONE interval and not a list: eTran keeps a
 * start and a length, so a segment that neither extends it at the front nor at
 * the back is DROPPED. The program used to fall off the end of the chain in
 * that case, silently leaving the segment to be treated as accepted.
 *
 * It works on the TRIMMED segment -- s.seq and s.payload_len, not the event's --
 * because what is stored has to be what would be delivered.
 */
void proc_ooo(tcp_data ev, tcp_ctx ctx, tcp_scratch s) {
    if (s.seg_ok)
        return;
    if (s.payload_len == 0)
        return;

    if (ctx.rx_ooo_len == 0) {
        ctx.rx_ooo_start = s.seq;
        ctx.rx_ooo_len = s.payload_len;
    } else if (s.seq + s.payload_len == ctx.rx_ooo_start) {
        ctx.rx_ooo_start = s.seq;
        ctx.rx_ooo_len = ctx.rx_ooo_len + s.payload_len;
    } else if (ctx.rx_ooo_start + ctx.rx_ooo_len == s.seq) {
        ctx.rx_ooo_len = ctx.rx_ooo_len + s.payload_len;
    } else {
        /* One interval, and this segment joins neither end of it. */
        s.payload_len = 0;
        s.drop = true;
    }
}

/*
 * proc_recv. The receive state advances, and an out-of-order extent that has
 * become contiguous is absorbed in the same pass.
 */
/*
 * ACCEPTANCE. Three things the program did not say and the donor does:
 *
 *  - THE RING WRAPS. rx_next_pos is an offset into a buffer of rx_buf_size, and
 *    without the wrap it walks off the end -- which is why rx_buf_size had to
 *    move to the eBPF group.
 *  - THE HELD INTERVAL IS REVALIDATED against the window that just moved, and
 *    trimmed, before it is asked whether it now joins. An interval that has
 *    fallen out of the window entirely is discarded, not merged.
 *  - Only THEN can it be delivered, and only if it starts exactly where the
 *    stream now does.
 *
 * It also works on the trimmed length, s.payload_len, not the event's.
 */
void proc_recv(tcp_data ev, tcp_ctx ctx, tcp_scratch s) {
    if (!s.seg_ok)
        return;
    if (s.payload_len == 0)
        return;

    s.rx_bump = s.payload_len;
    ctx.rx_avail = ctx.rx_avail - s.payload_len;
    ctx.rx_next_pos = ctx.rx_next_pos + s.payload_len;
    if (ctx.rx_next_pos >= ctx.rx_buf_size)
        ctx.rx_next_pos = ctx.rx_next_pos - ctx.rx_buf_size;
    ctx.rx_next_seq = ctx.rx_next_seq + s.payload_len;

    if (ctx.rx_ooo_len > 0) {
        /* The same wrap-safe overlap test as proc_seq, against the window as it
         * now stands. Written out again because MTP has no way to name a
         * predicate that is not an event processor. */
        uint32 exp_first = ctx.rx_next_seq;
        uint32 exp_last  = ctx.rx_next_seq + ctx.rx_avail;
        uint32 ooo_first = ctx.rx_ooo_start;
        uint32 ooo_last  = ctx.rx_ooo_start + ctx.rx_ooo_len;
        uint32 exp_width = exp_last - exp_first;
        uint32 ooo_width = ooo_last - ooo_first;

        bool first_in = (ooo_first - exp_first) < exp_width;
        bool last_in  = (ooo_last - exp_first - 1) < exp_width;
        bool valid = first_in || last_in
                  || (exp_first - ooo_first) < ooo_width
                  || (exp_last - ooo_first - 1) < ooo_width;

        if (!valid) {
            /* Entirely superfluous now. Dropped, and no acknowledgement. */
            ctx.rx_ooo_len = 0;
            s.trigger_ack = false;
            s.clear_ooo = true;
        } else {
            if (first_in)
                s.trim_start = 0;
            else
                s.trim_start = exp_first - ooo_first;
            if (last_in)
                s.trim_end = 0;
            else
                s.trim_end = ooo_last - exp_last;

            ctx.rx_ooo_start = ctx.rx_ooo_start + s.trim_start;
            ctx.rx_ooo_len = ctx.rx_ooo_len - s.trim_start - s.trim_end;

            if (ctx.rx_ooo_len > 0 && ctx.rx_ooo_start == ctx.rx_next_seq) {
                s.rx_bump = s.rx_bump + ctx.rx_ooo_len;
                ctx.rx_avail = ctx.rx_avail - ctx.rx_ooo_len;
                ctx.rx_next_pos = ctx.rx_next_pos + ctx.rx_ooo_len;
                if (ctx.rx_next_pos >= ctx.rx_buf_size)
                    ctx.rx_next_pos = ctx.rx_next_pos - ctx.rx_buf_size;
                ctx.rx_next_seq = ctx.rx_next_seq + ctx.rx_ooo_len;
                ctx.rx_ooo_len = 0;
            }
        }
    }
}

/*
 * record_data and proc_drain -- the application's own thread. These touch only
 * fields placed in "app", so they cannot run where the eBPF processors do, and
 * the compiler places them from that alone.
 */
void record_data(app_send ev, tcp_ctx ctx) {
    if (ctx.txb_allocated < ev.len)
        return;
    ctx.txb_allocated = ctx.txb_allocated - ev.len;
    ctx.txb_sent = ctx.txb_sent + ev.len;
}

void proc_drain(app_recv ev, tcp_ctx ctx) {
    if (ctx.rxb_used < ev.len)
        return;
    ctx.rxb_used = ctx.rxb_used - ev.len;
    ctx.rxb_bump = ctx.rxb_bump + ev.len;
    ctx.rxb_head = ctx.rxb_head + ev.len;
    ctx.force_rx_bump = false;
}

/**************************** the dispatch ****************************/

/*
 * THE tcp_ack AND tcp_data CHAINS INTERLEAVE, and the braid is written out
 * rather than implied. proc_window and proc_rtt are tcp_ack processors that run
 * AFTER tcp_data's sequence validation, and are skipped by its early exits.
 * Declaring them as two independent chains would be a different program.
 */
dispatch tcp_dispatch {
    app_bind    -> { proc_bind };
    app_listen  -> { proc_listen };
    app_accept  -> { proc_accept, proc_passive_open, gen_synack };
    app_connect -> { proc_connect, gen_syn };
    app_close   -> { proc_close };

    app_send    -> { record_data };
    app_recv    -> { proc_drain };

    tcp_syn     -> { proc_syn_queue, proc_passive_open, gen_synack };
    tcp_synack  -> { proc_synack };
    tcp_rst     -> { proc_rst };
    tcp_fin     -> { proc_fin };

    /*
     * THE BRAID. proc_window and proc_rtt belong to tcp_ack and run AFTER
     * tcp_data's proc_seq and proc_ooo, because that is the order the donor
     * runs them in and its early exits skip them. Declaring tcp_ack and
     * tcp_data as two independent chains would be a different program: a
     * segment with a bad sequence number would still update the receive window,
     * and in the donor it does not.
     */
    tcp_ack     -> { proc_ack, proc_fast_retransmit, proc_window, proc_rtt };
    tcp_data    -> { proc_seq, proc_ooo, proc_recv };
}
